# Expert Note - Environment Variables Template
# Copy this file to .env.local for development or .env for production

# Server Configuration
PORT=3000
NODE_ENV=development

# Base Path - CRITICAL for production deployment!
# Leave empty for local development (runs at http://localhost:3000)
# Set to /annote for production (runs at https://spansurvey.net/annote)
# IMPORTANT: This must be set BEFORE running `npm run build` - it's applied at build time!
BASE_PATH=

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=annotservice
# Local: Use your PostgreSQL username (e.g., ningli on Mac)
# Production: Use postgres
DB_USER=
# Local: Usually empty for Homebrew PostgreSQL
# Production: Set a secure password
DB_PASSWORD=

# OpenRouter API Key (for AI features)
# Get your key at https://openrouter.ai/
OPENROUTER_API_KEY=

# Session Secret (required for authentication)
# Generate a secure random string for production
# Example: openssl rand -hex 32
SESSION_SECRET=your-secret-key-here-change-in-production
